[Unit]
Description=Ratatoskr: watchdog for every part of Yggdrasil
After=network-online.target

[Service]
ExecStart=%h/.local/bin/ygg ratatoskr
# Where every part lives; a replaced part is pointed at here.
EnvironmentFile=-%h/.config/yggdrasil/parts.env
EnvironmentFile=%h/.config/yggdrasil/ratatoskr.env
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
