# Which parts this machine runs in containers. At work, leave out what you
# don't need there.
COMPOSE_PROFILES=norn,gjallar,munin,huginn,dellingr,hermodr,languagetool,embeddings

# Your Obsidian vault, for meeting notes both ways (Norn). Leave out for none.
# OBSIDIAN_VAULT_DIR=/mnt/c/Users/<you>/Documents/<vault>
# OBSIDIAN_VAULT_NAME=<vault>
