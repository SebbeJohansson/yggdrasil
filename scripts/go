#!/bin/sh
# The Go toolchain, run in Docker: this machine has no Go of its own.
# Uses your module and build caches, so it works offline once they are warm.
#
#   scripts/go test ./...
#   scripts/go build -o bin/ygg ./cmd/ygg
set -e
mkdir -p "$HOME/go/pkg/mod" "$HOME/.cache/go-build"
# Go plus git, which Sindri's tests drive. Built once, then cached.
if ! docker image inspect yggdrasil-go >/dev/null 2>&1; then
	printf 'FROM golang:1.25-alpine\nRUN apk add --no-cache git\n' | docker build -q -t yggdrasil-go - >/dev/null
fi
exec docker run --rm -u "$(id -u):$(id -g)" \
  -e HOME=/tmp -e GOMODCACHE=/gomod -e GOCACHE=/gocache -e CGO_ENABLED=0 -e GOFLAGS="${GOFLAGS:-}" \
  -v "$HOME/go/pkg/mod:/gomod" -v "$HOME/.cache/go-build:/gocache" \
  -v "$PWD:/src" -w /src yggdrasil-go go "$@"
